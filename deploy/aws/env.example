# Copiar como `.env` en la VM (cp env.example .env && chmod 600 .env) y completar.
# NUNCA subir el `.env` real al repositorio.

# Dominio público de la API (el que apunta a la IP de la VM en Cloudflare).
API_DOMAIN=api.nexusplaygames.com

# Origen(es) del frontend permitidos por CORS, separados por coma, sin "/" final.
CORS_ORIGIN=https://nexusplaygames.com,https://www.nexusplaygames.com

# --- Bases de datos (las mismas que usaba Railway) ---
DATABASE_URL=
MONGODB_URI=

# --- Auth ---
JWT_SECRET=
JWT_EXPIRES_IN=1d
GOOGLE_CLIENT_ID=

# --- Cloudinary ---
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# --- IA ---
GROQ_API_KEY=
GOOGLE_IA_STUDIO_API_KEY=
# Debe ser LA MISMA clave que usaba producción: si cambia, las API keys de IA guardadas en el panel dejan de descifrarse.
AI_CONFIG_ENCRYPTION_KEY=

# Copiar aquí también cualquier otra variable que tuviera el servicio en Railway
# (GROQ_MODEL, GROQ_VISION_MODEL, AI_PROVIDER_ORDER, etc.; ver server/.env.example).
ANALYTICS_ENABLED=false
