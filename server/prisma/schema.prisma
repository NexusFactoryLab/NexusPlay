// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model RoleModel {
  id        String      @id @default(uuid())
  name      String      @unique
  createdAt DateTime    @default(now()) @map("created_at")
  users     UserModel[]

  @@map("roles")
}

model UserModel {
  id                       String                         @id @default(uuid())
  /// Siempre en minúsculas: lo fuerza `users_email_lowercase_chk` (migración 20261028000100).
  email                    String                         @unique
  /// Nullable (issue #197): un usuario que solo entra por un proveedor OAuth
  /// (ej. Google) no tiene contraseña local. Ver `Password.none()`.
  passwordHash             String?                        @map("password_hash")
  firstName                String                         @map("first_name")
  middleName               String?                        @map("middle_name")
  lastName                 String                         @map("last_name")
  displayName              String                         @map("display_name")
  roleId                   String                         @map("role_id")
  role                     RoleModel                      @relation(fields: [roleId], references: [id])
  /// Issue selección de rol post-registro: todo usuario se crea como
  /// STUDENT por defecto; este flag indica si ya pasó por la pantalla de
  /// selección (o la cambió luego en Configuración) para no volver a
  /// mostrarla en cada login.
  hasChosenRole            Boolean                        @default(false) @map("has_chosen_role")
  avatarUrl                String?                        @map("avatar_url")
  /// Issue #77: avatar armado por piezas (tono de piel, peinado, ropa…). El
  /// formato lo valida `AvatarConfig`; null = la cuenta aún no tiene avatar.
  avatarConfig             Json?                          @map("avatar_config")
  birthDate                DateTime?                      @map("birth_date")
  locale                   String                         @default("es-CO")
  isActive                 Boolean                        @default(true) @map("is_active")
  isEmailVerified          Boolean                        @default(false) @map("is_email_verified")
  lastLoginAt              DateTime?                      @map("last_login_at")
  createdAt                DateTime                       @default(now()) @map("created_at")
  lastUpdate               DateTime                       @updatedAt @map("last_update")
  refreshTokens            RefreshTokenModel[]
  organizationsCreated     OrganizationModel[]            @relation("OrganizationCreatedBy")
  organizationMemberships  OrganizationMembershipModel[]
  classes                  ClassModel[]
  classEnrollments         ClassEnrollmentModel[]
  subjectsCreated          SubjectModel[]
  identityProviderAccounts IdentityProviderAccountModel[]
  gamePlayResults          GamePlayResultModel[]
  gameCreationDrafts       GameCreationDraftModel[]

  @@map("users")
}

/// Proveedores de identidad externa soportados para login federado (issue
/// #197). MICROSOFT no tiene flujo implementado todavía — existe para que
/// agregar un segundo proveedor no requiera otra migración estructural.
enum AuthProviderEnum {
  GOOGLE
  MICROSOFT

  @@map("auth_provider")
}

/// Identidad externa vinculada a un usuario (patrón NextAuth/Auth.js): 1
/// usuario puede tener 0, 1 o N identidades (una por proveedor). Reemplaza
/// el enfoque de columnas sueltas `authProvider`/`googleId` en `UserModel`
/// para que un segundo proveedor (Microsoft) no exija tocar esa tabla.
model IdentityProviderAccountModel {
  id             String           @id @default(uuid())
  userId         String           @map("user_id")
  user           UserModel        @relation(fields: [userId], references: [id], onDelete: Cascade)
  provider       AuthProviderEnum
  providerUserId String           @map("provider_user_id")
  /// Email reportado por el proveedor en el momento del vínculo — se guarda
  /// aparte de `UserModel.email` porque este último puede cambiar después.
  emailAtLinking String           @map("email_at_linking")
  createdAt      DateTime         @default(now()) @map("created_at")

  @@unique([provider, providerUserId])
  @@index([userId])
  @@map("identity_provider_accounts")
}

/// Rol de un usuario DENTRO de una organización. Eje ortogonal al rol global
/// de plataforma (tabla `roles`): un STUDENT global puede ser ADMIN de una
/// organización. Ver `domain/value-objects/organization-role.vo.ts`.
enum OrganizationRoleEnum {
  STUDENT
  TEACHER
  ADMIN

  @@map("organization_role")
}

model OrganizationModel {
  id              String    @id @default(uuid())
  name            String
  /// Dominio de correo reclamado (ej. "colegio.edu.co"). Único a nivel global:
  /// el constraint es la garantía real ante dos creaciones simultáneas.
  domain          String?   @unique
  createdByUserId String    @map("created_by_user_id")
  createdBy       UserModel @relation("OrganizationCreatedBy", fields: [createdByUserId], references: [id])
  createdAt       DateTime  @default(now()) @map("created_at")
  /// Desactivada = no admite nuevas matrículas/auto-join, conserva historial
  /// (issue #106, CA2.3). Campo propio, no derivado.
  isActive        Boolean   @default(true) @map("is_active")
  /// Código de invitación estático de la organización (issue #133, Frente A),
  /// generado una vez al crear. Único a nivel global para que
  /// POST /organizations/join lo resuelva sin ambigüedad.
  inviteCode      String    @unique @map("invite_code")

  memberships OrganizationMembershipModel[]
  classes     ClassModel[]

  @@index([createdByUserId])
  @@map("organizations")
}

model OrganizationMembershipModel {
  id             String               @id @default(uuid())
  organizationId String               @map("organization_id")
  organization   OrganizationModel    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  userId         String               @map("user_id")
  user           UserModel            @relation(fields: [userId], references: [id], onDelete: Cascade)
  orgRole        OrganizationRoleEnum @map("org_role")
  joinedAt       DateTime             @default(now()) @map("joined_at")

  @@unique([organizationId, userId])
  @@index([userId])
  @@map("organization_memberships")
}

model ClassModel {
  id             String             @id @default(uuid())
  name           String
  description    String             @default("")
  teacherUserId  String             @map("teacher_user_id")
  teacher        UserModel          @relation(fields: [teacherUserId], references: [id], onDelete: Cascade)
  /// Organización personal del profesor (issue #101). Opcional porque Class
  /// nació sin FK a Organization (agrupador privado vía teacherUserId
  /// solamente, ver issue #80); las clases creadas antes de esta migración
  /// quedan con organizationId null.
  organizationId String?            @map("organization_id")
  organization   OrganizationModel? @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  /// Código de invitación estático generado una vez al crear la clase (no
  /// rota). Único a nivel global para que POST /classes/join lo resuelva sin
  /// ambigüedad.
  inviteCode     String             @unique @map("invite_code")
  createdAt      DateTime           @default(now()) @map("created_at")
  /// Soft-delete (issue #133, Frente E): desactivada = no admite nuevas
  /// matrículas, pero las ClassEnrollment existentes no se tocan.
  isActive       Boolean            @default(true) @map("is_active")

  games       ClassGameModel[]
  enrollments ClassEnrollmentModel[]
  playResults GamePlayResultModel[]

  @@index([teacherUserId, createdAt(sort: Desc)])
  @@index([organizationId])
  @@map("classes")
}

/// Relación N:M entre una Class y un estudiante matriculado (issue #101).
/// Análoga a OrganizationMembership: la identidad real es el par
/// (classId, userId), respaldada por un constraint único compuesto para que
/// unirse dos veces con el mismo inviteCode sea idempotente/no duplique fila.
model ClassEnrollmentModel {
  id         String     @id @default(uuid())
  classId    String     @map("class_id")
  class      ClassModel @relation(fields: [classId], references: [id], onDelete: Cascade)
  userId     String     @map("user_id")
  user       UserModel  @relation(fields: [userId], references: [id], onDelete: Cascade)
  enrolledAt DateTime   @default(now()) @map("enrolled_at")

  @@unique([classId, userId])
  @@index([userId])
  @@map("class_enrollments")
}

/// Relación N:M entre una Class (agrupador privado de trabajo del profesor)
/// y un Game (que vive en MongoDB, no en Postgres — de ahí que gameId sea un
/// string suelto sin FK real; la existencia se valida a mano en el use-case
/// contra el repositorio de Game, igual que Subject.categoryId).
model ClassGameModel {
  id      String     @id @default(uuid())
  classId String     @map("class_id")
  class   ClassModel @relation(fields: [classId], references: [id], onDelete: Cascade)
  gameId  String     @map("game_id")
  addedAt DateTime   @default(now()) @map("added_at")
  /// Archivado DENTRO de esta clase (issue #226): oculta el juego de la vista
  /// activa de "Juegos de la clase" sin desvincularlo (a diferencia de
  /// `removeGame`, que sí borra la fila). No afecta al `Game` global ni a su
  /// uso en otras clases — es un flag de visibilidad local al vínculo
  /// Class<->Game, mismo criterio que `GameTypeSettingModel` pero a nivel de
  /// instancia en vez de a nivel de tipo.
  isArchived Boolean  @default(false) @map("is_archived")

  @@unique([classId, gameId])
  @@index([classId])
  @@map("class_games")
}

enum SubjectStatusEnum {
  PRIVATE
  PUBLIC

  @@map("subject_status")
}

/// Área raíz (parentSubjectId null, PUBLIC desde su creación por un admin) o
/// sub-área (parentSubjectId con valor, nace PRIVATE). PRIVATE -> PUBLIC es
/// irreversible; el soft-delete (deletedAt) solo aplica en PRIVATE, porque una
/// área pública puede tener juegos de otros usuarios colgados debajo.
model SubjectModel {
  id              String            @id @default(uuid())
  name            String
  slug            String            @unique
  parentSubjectId String?           @map("parent_subject_id")
  parent          SubjectModel?     @relation("SubjectHierarchy", fields: [parentSubjectId], references: [id], onDelete: Restrict)
  children        SubjectModel[]    @relation("SubjectHierarchy")
  /// null = área raíz creada por un admin sin registrar autoría individual.
  creatorUserId   String?           @map("creator_user_id")
  creator         UserModel?        @relation(fields: [creatorUserId], references: [id], onDelete: SetNull)
  status          SubjectStatusEnum @default(PRIVATE)
  deletedAt       DateTime?         @map("deleted_at")
  createdAt       DateTime          @default(now()) @map("created_at")

  @@index([parentSubjectId])
  @@index([creatorUserId])
  @@map("subjects")
}

enum GameTypeStatus {
  ACTIVE
  ARCHIVED
}

/// Registro crudo de cada intento de llamada a un proveedor de IA (issue
/// #204: fallback Gemini → Groq). `provider`/`operation` son `String` a
/// propósito, no un enum de Postgres — agregar un proveedor nuevo el día de
/// mañana (ver `AiProviderOrchestrator`) nunca debe requerir una migración
/// de esquema, solo escribir en esta tabla con un nombre nuevo. Panel de
/// administración de IA la lee; nada del flujo de generación depende de
/// leerla, solo de escribirla (best-effort, ver `AiProviderAttemptTracker`).
model AiProviderAttemptModel {
  id           String   @id @default(uuid())
  provider     String
  operation    String
  /// Agente que hizo la llamada (`GAME_PLAYER`…); null en filas anteriores.
  agent        String?
  succeeded    Boolean
  usedFallback Boolean  @map("used_fallback")
  errorMessage String?  @map("error_message")
  latencyMs    Int      @map("latency_ms")
  createdAt    DateTime @default(now()) @map("created_at")

  @@index([createdAt])
  @@map("ai_provider_attempts")
}

/// Proveedores de IA configurables desde el panel de administración (la
/// plataforma no depende de un proveedor fijo). `kind` es `String` a
/// propósito (igual que `AiProviderAttemptModel.provider`): sumar un tipo de
/// proveedor nuevo no requiere migración. La API key NUNCA se guarda en
/// claro: `encryptedApiKey` es AES-256-GCM (ver `AesGcmSecretCipher`) y
/// `apiKeyHint` solo conserva los últimos caracteres para mostrar en la UI.
model AiProviderConfigModel {
  id               String    @id @default(uuid())
  name             String    @unique
  kind             String
  baseUrl          String?   @map("base_url")
  textModel        String    @map("text_model")
  visionModel      String?   @map("vision_model")
  maxRpm           Int?      @map("max_rpm")
  encryptedApiKey  String    @map("encrypted_api_key")
  apiKeyHint       String    @map("api_key_hint")
  enabled          Boolean   @default(true)
  priority         Int       @default(0)
  lastTestAt       DateTime? @map("last_test_at")
  lastTestOk       Boolean?  @map("last_test_ok")
  lastTestMessage  String?   @map("last_test_message")
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")

  @@index([enabled, priority])
  @@map("ai_provider_configs")
}

/// Configuración de cada agente de IA de la plataforma (Jugador, Configurador
/// de juegos). Los agentes son un catálogo fijo en código (`AI_AGENT_CATALOG`):
/// esta tabla solo guarda lo que el administrador personalizó, así que una
/// fila ausente = valores por defecto. `providerId` no es FK a propósito: si el
/// proveedor se borra o se deshabilita, el agente cae a la cadena general en
/// vez de romperse (ver `AiAgentRuntime`).
model AiAgentConfigModel {
  agentKey          String   @id @map("agent_key")
  /// `null` = usa las instrucciones de fábrica vigentes del catálogo; `""` = "sin instrucciones".
  instructions      String?
  providerId        String?  @map("provider_id")
  modelOverride     String?  @map("model_override")
  fallbackToDefault Boolean  @default(true) @map("fallback_to_default")
  updatedAt         DateTime @updatedAt @map("updated_at")

  @@map("ai_agent_configs")
}

/// Contador de llamadas por ventana fija, compartido entre instancias del
/// servidor cuando `AI_RATE_LIMIT_STORE=postgres` (ver `PrismaRateLimitStore`).
/// `key` es un hash (nunca la API key). Las filas viejas se limpian solas.
model AiRateLimitHitModel {
  key         String
  windowStart BigInt @map("window_start")
  count       Int    @default(0)

  @@id([key, windowStart])
  @@map("ai_rate_limit_hits")
}

/// Registro de cambios del panel de IA (quién cambió qué proveedor/agente y
/// cuándo). `details` guarda solo nombres de campos y valores no sensibles:
/// NUNCA una API key, ni en claro ni cifrada (ver `AiAuditLogger`).
/// `actorName` y `targetLabel` son copias del momento del cambio, para que el
/// registro siga legible si el usuario o el proveedor ya no existen.
model AiAuditLogModel {
  id          String   @id @default(uuid())
  actorUserId String   @map("actor_user_id")
  actorName   String   @map("actor_name")
  action      String
  targetType  String   @map("target_type")
  targetId    String   @map("target_id")
  targetLabel String   @map("target_label")
  details     Json     @default("{}")
  createdAt   DateTime @default(now()) @map("created_at")

  @@index([createdAt])
  @@map("ai_audit_logs")
}

/// Gobernanza transversal por `GameType` (issue #156): archivar un tipo es
/// una capa de visibilidad EN TIEMPO DE LECTURA que cruza `gameType` contra
/// esta tabla — nunca se itera ni se modifica el `GameStatus` individual de
/// las instancias de `Game` (que viven en Mongo). Al desarchivar, todo
/// reaparece automáticamente sin ningún script de migración de datos.
model GameTypeSettingModel {
  id               String         @id @default(uuid())
  gameType         String         @unique @map("game_type")
  status           GameTypeStatus @default(ACTIVE)
  displayName      String         @map("display_name")
  description      String?
  archivedAt       DateTime?      @map("archived_at")
  archivedByUserId String?        @map("archived_by_user_id")
  createdAt        DateTime       @default(now()) @map("created_at")
  updatedAt        DateTime       @updatedAt @map("updated_at")

  @@map("game_type_settings")
}

/// Registro de un intento/partida jugada por un estudiante (issue #226).
/// Es el hecho atómico sobre el que se agregan todas las métricas: ranking de
/// clase, desglose por juego, desglose por área y evolución en el tiempo.
/// `gameId`/`subjectId` son strings sueltos sin FK real por el mismo motivo
/// que `ClassGameModel.gameId`: `Game` vive en MongoDB y `Subject` sí vive en
/// Postgres pero se referencia por id de todas formas para no acoplar esta
/// tabla de hechos a reglas de integridad de otro agregado (un área
/// eliminada no debe impedir conservar el historial de resultados).
model GamePlayResultModel {
  id             String     @id @default(uuid())
  studentUserId  String     @map("student_user_id")
  student        UserModel  @relation(fields: [studentUserId], references: [id], onDelete: Cascade)
  classId        String?    @map("class_id")
  class          ClassModel? @relation(fields: [classId], references: [id], onDelete: SetNull)
  gameId         String     @map("game_id")
  /// Denormalizado al momento de registrar el resultado: evita tener que ir a
  /// Mongo a resolver `gameType`/`title` para listar el desglose por juego.
  gameTitle      String     @map("game_title")
  subjectId      String?    @map("subject_id")
  /// Denormalizado por el mismo motivo que `gameTitle`, y porque un área
  /// puede eliminarse (soft-delete) sin que eso rompa el historial agregado.
  subjectName    String?    @map("subject_name")
  score          Int
  correctCount   Int        @map("correct_count")
  incorrectCount Int        @map("incorrect_count")
  timePlayedMs   Int        @map("time_played_ms")
  playedAt       DateTime   @default(now()) @map("played_at")

  @@index([studentUserId, playedAt])
  @@index([classId, playedAt])
  @@index([studentUserId, subjectId])
  @@index([gameId])
  @@map("game_play_results")
}

model RefreshTokenModel {
  id        String    @id @default(uuid())
  userId    String    @map("user_id")
  user      UserModel @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique @map("token_hash")
  expiresAt DateTime  @map("expires_at")
  createdAt DateTime  @default(now()) @map("created_at")
  revokedAt DateTime? @map("revoked_at")

  @@index([userId])
  @@map("refresh_tokens")
}

/// Issue #69: borrador automático del formulario de creación de juego. Una
/// persona puede tener varios por tipo (el id lo genera el cliente al abrir el
/// formulario y sirve también de etiqueta `draft-<id>` en Cloudinary).
/// "Borrador" aquí es el trabajo a medias de la persona; no confundir con
/// `GameDraft` del código, que es el resultado de la IA (va en `aiResult`).
/// `mode` es '' cuando el tipo no tiene modos.
model GameCreationDraftModel {
  id        String    @id
  userId    String    @map("user_id")
  user      UserModel @relation(fields: [userId], references: [id], onDelete: Cascade)
  gameType  String    @map("game_type")
  mode      String    @default("")
  /// Estado completo del formulario (lo serializa cada formulario).
  formState Json?     @map("form_state")
  /// Resultado de POST /games/ai-draft, para no volver a gastar tokens.
  aiResult  Json?     @map("ai_result")
  /// Mensaje que se envió a la IA junto con los archivos.
  aiMessage String?   @map("ai_message")
  /// Archivos subidos a la IA, ya en Cloudinary: [{ filename, mimeType, sizeBytes, url, publicId }].
  aiFiles   Json?     @map("ai_files")
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")

  @@index([userId, updatedAt])
  @@index([updatedAt])
  @@map("game_creation_drafts")
}
